# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Supabase project settings (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SMS OTP provider key (e.g. MSG91), only needed if not using Supabase's
# built-in phone auth provider directly.
VITE_SMS_OTP_PROVIDER_KEY=dummy-msg91-key
